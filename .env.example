# Adres serwera w sieci wewnętrznej - usługi nasłuchują tylko na nim (nie 0.0.0.0!)
BIND_IP=10.0.0.10
HTTP_PORT=80
DICOM_PORT=4242
DICOM_AET=PACS
# Po skonfigurowaniu listy aparatów ustaw DICOM_ALWAYS_ALLOW_STORE=false
DICOM_MODALITIES={}
DICOM_ALWAYS_ALLOW_STORE=true

POSTGRES_USER=pacs
POSTGRES_PASSWORD=zmien-mnie

ORTHANC_USER=pacs
ORTHANC_PASSWORD=zmien-mnie-tez
# echo -n "$ORTHANC_USER:$ORTHANC_PASSWORD" | base64
ORTHANC_BASIC_AUTH=cGFjczp6bWllbi1tbmllLXRleg==

# Powiadomienia e-mail (wewnętrzny serwer pocztowy szpitala)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=pacs@szpital.local
# Adres, pod którym lekarze otwierają aplikację (do linków w powiadomieniach)
PUBLIC_BASE_URL=http://10.0.0.10
# Słowa w opisie/priorytecie badania oznaczające tryb pilny
URGENT_KEYWORDS=PILNE,CITO,STAT,URGENT,ZAGROZENIE

# Bramka SMS (np. SMSAPI.pl) - powiadomienia lekarzy przy eskalacji i SMS do pacjenta
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=PRACOWNIA
# Termin opisu: pilne (minuty) i rutynowe (godziny)
SLA_URGENT_MINUTES=60
SLA_ROUTINE_HOURS=72
# Co ile minut niepotwierdzony wynik krytyczny idzie o stopień wyżej
CRITICAL_ESCALATION_MINUTES=15
PACS_DOMAIN=pacs.oczamielektroradiologa.pl
